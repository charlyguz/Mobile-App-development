<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/nav_main">

    <fragment
        android:id="@+id/nav_main"
        android:name="com.example.cityexplorerchallenge.ui.main.MainFragment"
        android:label="Challenge"
        tools:layout="@layout/fragment_main">
        <action
            android:id="@+id/action_main_to_details"
            app:destination="@id/nav_details" />
        <action
            android:id="@+id/action_main_to_map"
            app:destination="@id/nav_map" />
    </fragment>

    <fragment
        android:id="@+id/nav_map"
        android:name="com.example.cityexplorerchallenge.ui.map.MapFragment"
        android:label="Map"
        tools:layout="@layout/fragment_map" />
        
    <fragment
        android:id="@+id/nav_history"
        android:name="com.example.cityexplorerchallenge.ui.history.HistoryFragment"
        android:label="History"
        tools:layout="@layout/fragment_history" />
        
    <fragment
        android:id="@+id/nav_statistics"
        android:name="com.example.cityexplorerchallenge.ui.statistics.StatisticsFragment"
        android:label="Statistics"
        tools:layout="@layout/fragment_statistics" />

    <fragment
        android:id="@+id/nav_details"
        android:name="com.example.cityexplorerchallenge.ui.details.ChallengeDetailsFragment"
        android:label="Details"
        tools:layout="@layout/fragment_challenge_details" />

</navigation>
