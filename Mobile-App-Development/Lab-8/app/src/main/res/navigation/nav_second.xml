<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_second"
    app:startDestination="@id/firstFragment">

    <fragment
        android:id="@+id/firstFragment"
        android:name="com.example.carlosguzmanandroidfragmentsandnavigation.FirstFragment"
        android:label="First Fragment"
        tools:layout="@layout/fragment_first">
        <action
            android:id="@+id/action_firstFragment_to_secondFragment"
            app:destination="@id/secondFragment" />
        <action
            android:id="@+id/action_firstFragment_to_thirdFragment"
            app:destination="@id/thirdFragment" />
        <action
            android:id="@+id/action_firstFragment_to_actionsActivity"
            app:destination="@id/actionsActivity" />
    </fragment>

    <fragment
        android:id="@+id/secondFragment"
        android:name="com.example.carlosguzmanandroidfragmentsandnavigation.SecondFragment"
        android:label="Second Fragment"
        tools:layout="@layout/fragment_second">
        <action
            android:id="@+id/action_secondFragment_to_firstFragment"
            app:destination="@id/firstFragment"
            app:popUpTo="@id/firstFragment"
            app:popUpToInclusive="false" />
    </fragment>

    <fragment
        android:id="@+id/thirdFragment"
        android:name="com.example.carlosguzmanandroidfragmentsandnavigation.ThirdFragment"
        android:label="Third Fragment"
        tools:layout="@layout/fragment_third">
        <action
            android:id="@+id/action_thirdFragment_to_firstFragment"
            app:destination="@id/firstFragment"
            app:popUpTo="@id/firstFragment"
            app:popUpToInclusive="false" />
    </fragment>

    <activity
        android:id="@+id/actionsActivity"
        android:name="com.example.carlosguzmanandroidfragmentsandnavigation.ActionsActivity"
        android:label="Actions Activity"
        tools:layout="@layout/activity_actions" />

</navigation>
