<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp"
    android:background="@android:color/holo_orange_light"
    tools:context=".ActionsActivity">

    <TextView
        android:id="@+id/actions_title_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Actions Activity"
        android:textSize="28sp"
        android:textStyle="bold"
        android:layout_marginBottom="32dp" />

    <Button
        android:id="@+id/write_to_logcat_btn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Write to LogCat"
        android:textSize="18sp" />

    <Button
        android:id="@+id/show_toast_btn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Show Toast"
        android:textSize="18sp" />

    <Button
        android:id="@+id/write_to_edit_text_btn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Write to EditText"
        android:textSize="18sp" />

    <EditText
        android:id="@+id/actions_edit_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Text will appear here"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp" />

    <Button
        android:id="@+id/back_to_first_fragment_btn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Back To First Fragment"
        android:textSize="18sp" />

</LinearLayout>